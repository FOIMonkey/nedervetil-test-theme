<div id="right_column_flip" class="right_column_flip">
<h2>About</h2>
<ul class="no_bullets">
  <li><%= link_to_unless_current "About this site", help_about_path %></li>
  <li><%= link_to_unless_current "Privacy", help_privacy_path %></li>
  <li><%= link_to_unless_current "For public authorities", help_officers_path %></li>
  <li><%= link_to_unless_current "Contact", help_contact_path %></li>
  <li><%= link_to_unless_current "About the software", help_alaveteli_path %></li>
</ul>

