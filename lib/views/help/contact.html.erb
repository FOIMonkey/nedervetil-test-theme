<% @title = "Contact" %>

<%= page_band %>

<%= foi_error_messages_for :contact %>

<div id="contact_preamble" class="contact_preamble">
  <% if !flash[:notice] %>
    <p>This form sends a message to the person who runs <%= site_name %>.
      Use it to ask about a document published here, or to say that something
      should not have been published.</p>
    <p>It does not reach any public authority. To contact one, use the
      details on its own website.</p>
  <% end %>
</div>

<%= form_for :contact do |f| %>

  <% if not @user %>
    <p>
      <label class="form_label" for="contact_name">Your name</label>
      <%= f.text_field :name, :size => 20, :autocomplete => 'name' %>
    </p>

    <p>
      <label class="form_label" for="contact_email">Your email</label>
      <%= f.text_field :email, :size => 20, :autocomplete => 'email' %>
    </p>
  <% end %>

  <p>
    <label class="form_label" for="contact_subject">Subject</label>
    <%= f.text_field :subject, :size => 50 %>
  </p>

  <p>
    <label class="form_label" for="contact_message">Message</label>
    <%= f.text_area :message, :rows => 10, :cols => 60 %>
  </p>

  <p style="display:none;">
    <%= f.label :comment, 'Do not fill in this field' %>
    <%= f.text_field :comment %>
  </p>

  <% if !@last_request.nil? %>
    <p>
      <span class="form_label">This message will include a link to the request:</span>
      <%=request_link(@last_request) %>
      <%= submit_tag "remove", :name => 'remove' %>
    </p>
  <% end %>
  <% if !@last_body.nil? %>
    <p>
      <span class="form_label">This message will include a link to the authority:</span>
      <%=public_body_link(@last_body) %>
      <%= submit_tag "remove", :name => 'remove' %>
    </p>
  <% end %>

  <%# The person check, for a signed-out visitor (HelpController). %>
  <% if @turnstile_required %>
    <%= turnstile_box('contact') %>
  <% end %>

  <div class="form_button">
    <%= hidden_field_tag(:submitted_contact_form, 1) %>
    <%= submit_tag "Send message", :data => { :disable_with => "Sending..." } %>
  </div>

<% end %>
