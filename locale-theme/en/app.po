# Wording changes for this site.
#
# Alaveteli looks here before its own locale files, so giving a core English
# string a "translation" replaces it everywhere it is used, without copying
# any template. The msgid must match core's string exactly.
#
# This file is written by tools/locale/build-po.py (kept outside this
# repository), which handles the quoting. It can also be edited by hand.
# After upgrading Alaveteli, check that every msgid still exists in core:
# a reworded core string silently stops being replaced.
#
# Changes need an app restart to show.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: en\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"


# The strapline. Core uses this string after the site name in <title> and in
# the social sharing tags; the theme's header shows it next to the site name.
# PLACEHOLDER wording until the owner chooses one.

msgid "Make and browse Freedom of Information (FOI) requests"
msgstr "Freedom of Information requests, and what came back"

# Dates in British order: 3 March 2026. Core reads its date format from this
# string and falls back to an American one when it is not translated.

msgid "simple_date_format"
msgstr "%-d %B %Y"

# Status names. The site's vocabulary is: All information provided, Some
# information provided, No information, Waiting response, Waiting
# classification, Internal review, Under appeal. Core's states are unchanged
# underneath; these are their display names. Lateness still shows.
# "No information" is core's "Refused". Core's "Information not held" is
# not used on this site (the app stores it as refused: either
# way nothing was released), and is given the same name in case it is ever
# met.

# The status sentence at the top of a request page.

# "No information" where core says "refused": the form the owner sets a
# status with, the notice shown after setting it, and the table of search
# terms. Refused and not held are one outcome here (lib/model_patches.rb).

msgid "All the options below can use <strong>status</strong> or <strong>latest_status</strong> before the colon. For example, <strong>status:not_held</strong> will match requests which have <em>ever</em> been marked as not held; <strong>latest_status:not_held</strong> will match only requests that are <em>currently</em> marked as not held."
msgstr "All the options below can use <strong>status</strong> or <strong>latest_status</strong> before the colon. For example, <strong>status:rejected</strong> will match requests which have <em>ever</em> been marked as no information; <strong>latest_status:rejected</strong> will match only requests that are <em>currently</em> marked as no information."

msgid "The request was refused by the public authority"
msgstr "No information was provided"

msgid "The public authority does not have the information requested"
msgstr "Not used on this site: see status:rejected"

# Request page.

msgid "Requests like this"
msgstr "Related requests"

msgid "Act on what you've learnt"
msgstr "Share"

msgid "Download a zip file of all correspondence"
msgstr "Download everything (zip)"

msgid "View event history details"
msgstr "Full history"

# The "full history" page of a request.

msgid "This table shows the technical details of the internal events that happened to this request on {{site_name}}. This could be used to generate information about the speed with which authorities respond to requests, the number of requests which require a postal response and much more."
msgstr "This table is the technical record of this request on {{site_name}}: when each message was sent or received, and when its status was set. The states are shown by their internal names."

msgid "<strong>Be careful!</strong> To use this data in an honourable way, you will need a good internal knowledge of user behaviour on {{site_name}}. How, why and by whom requests are categorised is not straightforward, and there will be user error and ambiguity. You will also need to understand FOI law, and the way authorities use it. Plus you'll need to be an elite statistician.  Please <a href=\"{{contact_path}}\">contact us</a> with questions."
msgstr "A status is set by the requester after reading each reply, so it is a judgement, not a measurement. <a href=\"{{contact_path}}\">Get in touch</a> with questions."

# Error pages.

msgid "Sorry, we couldn't find that page"
msgstr "Page not found"

